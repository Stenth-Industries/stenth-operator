{
  "name": "stenth-operator",
  "version": "1.1.0",
  "private": true,
  "description": "STENTH Operator V1 — discovers, researches, qualifies and ranks Australian law-firm prospects and prepares outreach for human approval. Holds no mail-sending credential.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-no-mail.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:reliability": "vitest run tests/reliability"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
