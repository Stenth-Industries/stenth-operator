# STENTH Operator V1.1 — environment (SPEC.md §17).
#
# Copy to .env on the VPS, chmod 600, service-user owned. No secret belongs in
# the repository and none is stored in the database in plaintext.
#
# THERE IS NO MAIL CREDENTIAL IN THIS FILE, AND THERE IS NONE ANYWHERE IN THE
# DEPLOYMENT. No Gmail OAuth client, no refresh token, no SMTP host, no
# SendGrid/Postmark/Resend key (§1, §14, §17). Approval writes an immutable
# record and the human sends the message from their own Gmail. If a mail
# credential ever appears here, that is a security decision with its own scope
# analysis, not a convenience.

NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=web
PORT=3000

# --- Database -----------------------------------------------------------------
# The application role (operator_app): DML on application tables only.
DATABASE_URL=postgresql://operator_app:CHANGE_ME@postgres:5432/operator

# Used ONLY by the migration step, which creates the extensions and the five
# roles of §17. Not present on the running web or worker containers.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/operator

# One password per role (§17). Rotate quarterly.
POSTGRES_PASSWORD=CHANGE_ME
OPERATOR_APP_PASSWORD=CHANGE_ME
OPERATOR_FETCH_PASSWORD=CHANGE_ME
OPERATOR_SCHED_PASSWORD=CHANGE_ME
OPERATOR_MIGRATE_PASSWORD=CHANGE_ME
OPERATOR_RO_PASSWORD=CHANGE_ME

# --- AI budget (§2, §16) ------------------------------------------------------
# Deliberately conservative for the first two weeks: roughly 20-40 discovered
# prospects a day, 10-15 deeply assessed, 5-8 shown for review. The budgets
# table is the operational source of truth; these are the values a month's row
# is created with. Raise only after the two-week review of cost per assessed
# prospect and cost per qualified prospect.
AI_BUDGET_MONTHLY_USD=50
AI_BUDGET_WARN_USD=35
AI_BUDGET_HARD_STOP_USD=50

# --- Secrets introduced by later days ----------------------------------------
# Day 3 (§8): shared secret for the worker -> fetcher internal endpoint.
# FETCHER_SHARED_SECRET=

# Day 4 (§17): metered model provider API key with billing attached. Note that
# development credit on a Claude Cloud session is NOT production API budget.
# MODEL_API_KEY=

# Day 8 (§13): session cookie signing key.
# SESSION_SIGNING_KEY=
